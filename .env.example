# Nullhost Server Configuration
# Copy this file to .env and configure as needed for your server.

# ==============================================================================
# Cloudflare Turnstile CAPTCHA (100% Optional)
# ==============================================================================
# Set to 1 to enable Cloudflare Turnstile protection for public web browser uploads.
# Set to 0 (or leave keys empty) to disable Turnstile completely.
# When disabled, Nullhost runs 100% self-contained without any third-party credentials.
ENABLE_TURNSTILE=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ACTION=turnstile-spin-v2

# ==============================================================================
# Mobile Application Authentic Secret
# ==============================================================================
# Shared secret used to cryptographically verify uploads from official mobile apps
# (Symbian Belle FP2, S60 Keypad, Universal Java ME, Windows Desktop Client).
# Mobile apps use an HMAC-SHA256 handshake to safely bypass web CAPTCHAs.
NULLHOST_MOBILE_APP_KEY=nullhost_secret_mobile_app_key_2026

# ==============================================================================
# Administrator 2FA (TOTP) Secret (Optional)
# ==============================================================================
# Base32 secret for Google Authenticator / 2FA apps to access /admin.
# Configured via environment variable so no plaintext secret or QR code is stored on disk.
ADMIN_TOTP_SECRET=
